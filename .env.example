# Cloudflare Workers AI (Level 3 — Diffusion Model)
# Account ID: Cloudflare dashboard → Workers & Pages → Overview (right sidebar)
# API Token: My Profile → API Tokens → Create Token (needs "Workers AI" read/run)
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token

# Fal.ai (Story Illustrator — Consistent Character/Scene Images)
# Get key at: https://fal.ai/dashboard
FAL_KEY=your_fal_key

# ElevenLabs (Story Narrator — Text-to-Speech for Storybooks)
# Get key at: https://elevenlabs.io
# Also configure in .mcp.json for MCP server integration
ELEVENLABS_API_KEY=your_elevenlabs_api_key